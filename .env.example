# Optional. Leave empty to run with the in-browser deterministic analysis engine only.
# When set, the AI Analytics Lab sends a compact, aggregated summary (no row-level data)
# to this endpoint and labels the answer as produced by a language model.
VITE_AI_ENDPOINT=

# Server-side only (Vercel function in /api). NEVER prefix with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ALLOWED_ORIGIN=

# Base path for the build. "/" for Vercel, "/<repo-name>/" for GitHub Pages.
VITE_BASE=/
